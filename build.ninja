# leopard-rc 构建（消费 ../leopard-sdk）
ninja_required_version = 1.10
cc = clang
cxx = clang++
ld = ld
c_flags = -fdiagnostics-color=always -O2 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -fno-stack-protector -fno-exceptions -fno-strict-aliasing -fshort-wchar -nostdinc -std=c11   -I ../leopard-sdk/include -I . -MMD -MP
cpp_flags = -fdiagnostics-color=always -O2 -Wall -g -ffreestanding -fno-builtin -m64 -mstackrealign -fno-stack-protector -fno-exceptions -fno-strict-aliasing -fshort-wchar -nostdinc -std=c++11 -I ../leopard-sdk/include -I . -Wno-write-strings -MMD -MP

rule cc
  command = mkdir -p $$(dirname $out) && $cc $c_flags -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc

rule cxx
  command = mkdir -p $$(dirname $out) && $cxx $cpp_flags -MF $out.d -c $in -o $out
  depfile = $out.d
  deps = gcc

rule link
  command = $ld -Ttext=0x200000 $in -o $out

build out/main.c.o: cc main.c
build out/service.c.o: cc service.c

build out/leopard-rc.elf: link ../leopard-sdk/obj-tui/crt0.o ../leopard-sdk/obj-tui/libsys.cpp.o ../leopard-sdk/obj-tui/xgui_stubs.cpp.o ../leopard-sdk/obj-tui/constart.cpp.o ../leopard-sdk/obj-tui/xtuiapi.cpp.o ../leopard-sdk/obj-tui/krlibc.cpp.o out/main.c.o out/service.c.o ../leopard-sdk/obj-tui/liballoc-x86_64.a

build all: phony out/leopard-rc.elf
default all

rule clean
  command = rm -rf out
build clean: clean
